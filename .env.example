# ==============================================================================
# Nightwatch Configuration
# Copy this file to .env and configure your secrets
# ==============================================================================

# Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=60

# GitHub Integration
GITHUB_TOKEN=
GITHUB_REPO=

# Telegram Alerts & Approval Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Security & Authentication
DASHBOARD_PASSWORD=nightwatch-dev-secret
TICK_SECRET=nightwatch-scheduler-tick-secret

# Storage Backend (sqlite | firestore)
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=nightwatch.db
