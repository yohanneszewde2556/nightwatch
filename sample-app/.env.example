# demo-shop Configuration

# Admin token required in X-Admin-Token header for /admin routes
ADMIN_TOKEN=demo-admin-secret

# Initial app version: v1 (working) or v2 (buggy discounts)
APP_VERSION=v1

# Initial chaos mode: none, slow, down
CHAOS_MODE=none

# Seconds between simulated background requests (0 to disable)
TRAFFIC_INTERVAL_SECONDS=1.5
TRAFFIC_ENABLED=true

# Log ring buffer capacity
LOG_BUFFER_SIZE=1000

# Server port
PORT=8001
